# Copy to .env. Docker Compose reads it automatically; values here are the defaults.

# Postgres (docker compose)
POSTGRES_USER=webhooks
POSTGRES_PASSWORD=webhooks
POSTGRES_DB=webhooks
# Change if a local Postgres already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgres://webhooks:webhooks@127.0.0.1:5432/webhooks

# SQS queues, created by the create-queues service (ADR-0002).
SQS_QUEUE_NAME=deliveries
SQS_DLQ_NAME=deliveries-dlq
# Must be longer than the 10 s delivery request timeout (ADR-0002).
SQS_VISIBILITY_TIMEOUT_SECONDS=60
# Messages that crash workers this many times move to the SQS DLQ.
SQS_MAX_RECEIVE_COUNT=5

# AWS SDK for the app running on the host, pointed at the AWS Emulator (ADR-0005).
# The emulator writes new credentials and a new CA certificate on every start,
# so restart the app after restarting the emulator.
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=./.aws-emulator/9297/emulator_credentials
AWS_EC2_METADATA_DISABLED=true
# The JS SDK v3 trusts the emulator's certificate through NODE_EXTRA_CA_CERTS,
# not AWS_CA_BUNDLE. Node reads it only at startup, so it must be in the
# environment before node starts.
NODE_EXTRA_CA_CERTS=./.aws-emulator/9297/ca.pem
